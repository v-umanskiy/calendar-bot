# Copy to .env (git-ignored). Contains configuration only, never secret values.
# Secret values live in AWS Secrets Manager and are read at runtime.

AWS_PROFILE=your-aws-profile
AWS_REGION=eu-west-1

# Secrets Manager secret (JSON) holding the keys listed in README.md
SECRETS_ARN=

HISTORY_TABLE_NAME=
EVENT_DRAFT_TABLE_NAME=event_draft_dev
GOOGLE_OAUTH_TABLE_NAME=calendar_google_oauth_dev
GOOGLE_EVENT_LINKS_TABLE_NAME=calendar_google_event_links_dev
S3_BUCKET_NAME=
GOOGLE_OAUTH_KMS_KEY_ID=
